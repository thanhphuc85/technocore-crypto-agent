# /etc/technocore-agent/env  — SECRETS + cấu hình cho systemd (root:root, chmod 0600).
# KHÔNG commit file thật. Chỉ `KEY=value` mỗi dòng (không `export`, không quote thừa).
# Danh sách van FLOP đầy đủ xem .env.example ở gốc repo — ở đây chỉ nêu tối thiểu + gợi ý.

# ── BẮT BUỘC: danh tính agent ───────────────────────────────────────────────
# Seed Ed25519 (64 hex) = DANH TÍNH + uy tín. KHÔNG BAO GIỜ chia sẻ/commit/log.
# Tốt hơn: để trong secret manager (OCI Vault/1Password/HashiCorp) và nạp vào đây lúc boot.
AGENT_PRIVATE_KEY=
AGENT_NAME=NguyenVuLV
# KV_NS mặc định = AGENT_NAME viết thường; đặt tường minh nếu muốn.
# KV_NS=nguyenvulv

# ── LLM providers (ít nhất một) — chuỗi auto: Groq -> Gemini -> DeepSeek -> OpenAI ──
GROQ_API_KEY=
GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# ── Phối hợp 2 runner (tránh double-post nếu CHẠY SONG SONG với GitHub Actions) ──
# Đặt backup -> VPS chỉ chạy đầy đủ khi heartbeat của runner CHÍNH đã CŨ (hot standby).
# Để primary (và tắt/để standby phía Actions) nếu muốn VPS là runner chính.
RUNNER_ROLE=backup

# ── Room (khớp cấu hình hiện tại) ───────────────────────────────────────────
AGENT_ROOM=flop
MANIFEST_ROOM=lobby
AGENT_ROOMS=lobby,meta,flop

# ── Van FLOP: copy các biến cần từ .env.example gốc repo. Ví dụ các cái đang bật: ──
# FLOP_ENGAGE_ENABLED=on
# FLOP_KIBBLE_ENABLED=true
# FLOP_KIBBLE_MAX_PER_RUN=5
# FLOP_STATUS_FEED_ENABLED=on
# PROACTIVE=on

# ── TESTNET EARN (giữ TẮT tới khi FLOP mở + công bố endpoint) ────────────────
# TESTNET_ENABLED=0
# FLOP_FAUCET_ENABLED=
# FLOP_FAUCET_URL=
# FLOP_SESSION_ENABLED=
# FLOP_SESSION_MODEL_HASH=
# FLOP_MEMPOOL_URL=
# FLOP_RPC_URL=
# FLOP_SUBMIT_URL=
# FLOP_SESSION_MAX_PER_RUN=1
