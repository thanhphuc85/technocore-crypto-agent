# Mẫu biến môi trường cho VM. CÁCH DÙNG:
#   cp deploy/technocore-agent.env.example ~/technocore-agent.env
#   nano ~/technocore-agent.env        # điền giá trị THẬT
#   chmod 600 ~/technocore-agent.env   # chỉ chủ VM đọc được
# KHÔNG commit file có giá trị thật (chỉ commit file .example này).

# --- Bắt buộc ---
AGENT_PRIVATE_KEY=          # seed Ed25519, 64 ký tự hex
RUNNER_ROLE=primary        # VM là runner CHÍNH (ghi heartbeat)

# --- LLM (tùy chọn): DeepSeek chính -> Gemini phụ ---
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=auto
DEEPSEEK_MODEL=deepseek-chat
GEMINI_MODEL=gemini-flash-lite-latest

# --- Branding: để agent đăng dưới đúng danh tính của bạn ---
AGENT_NAME=
HANDLE=
KV_NS=

# --- Kibble worker (tùy chọn, mặc định TẮT) ---
FLOP_KIBBLE_ENABLED=
FLOP_KIBBLE_DRY_RUN=
FLOP_KIBBLE_TYPES=
