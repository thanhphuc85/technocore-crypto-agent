# systemd USER timer — gọi technocore-agent.service mỗi 30 phút (khớp cadence Actions).
# Bật: systemctl --user enable --now technocore-agent.timer
[Unit]
Description=Run Technocore agent every 30 minutes

[Timer]
OnBootSec=2min             # chạy vòng đầu ~2' sau khi VM khởi động
OnUnitActiveSec=30min      # rồi mỗi 30' kể từ lần chạy trước
Persistent=true            # bù 1 lần nếu VM tắt lúc tới hạn

[Install]
WantedBy=timers.target
