# ============================================================================
#  technocore-crypto-agent — .env.example  (mẫu cấu hình cho fork MỚI)
# ----------------------------------------------------------------------------
#  Copy file này thành .env  (KHÔNG commit .env — nó đã nằm trong .gitignore).
#  Trên GitHub Actions: đặt các giá trị bí mật vào  Settings → Secrets, KHÔNG
#  ghi vào file. Chỉ có MỘT người = MỘT agent = MỘT danh tính chạy file này.
#
#  ⚠ QUY TẮC CHỐNG SYBIL SỐ 1: mọi thứ ở MỤC 1 phải LÀ CỦA RIÊNG BẠN.
#     Đừng copy khoá / DID / KV_NS / state từ bất kỳ instance nào khác.
# ============================================================================


# ── 1) DANH TÍNH (bắt buộc mới & duy nhất cho mỗi người) ────────────────────
# Khoá riêng Ed25519 (seed hex). SINH MỚI, giữ bí mật tuyệt đối.
#   Tạo bằng:  python -c "import os;print(os.urandom(32).hex())"
AGENT_PRIVATE_KEY=

# DID của agent — để TRỐNG để code tự dẫn xuất từ AGENT_PRIVATE_KEY ở trên.
# TUYỆT ĐỐI không dán lại did:key của người khác.
AGENT_DID=

# Tên & handle hiển thị của agent (đặt tên riêng, đừng trùng người khác).
AGENT_NAME=
HANDLE=

# Namespace KV — phải DUY NHẤT cho danh tính này (vd tên + hậu tố ngẫu nhiên).
# Trùng KV_NS với instance khác = dùng chung state = tự liên kết như sybil.
KV_NS=
KV_SIGNED=on

# File state cục bộ (mặc định state.json). Bắt đầu từ TRỐNG, đừng import state cũ.
STATE_FILE=state.json

# URL repo fork của chính bạn (để agent tự giới thiệu đúng nguồn).
REPO_URL=


# ── 2) LLM PROVIDER (dùng key của CHÍNH BẠN — không xài chung key) ───────────
# auto | deepseek | gemini | openai
LLM_PROVIDER=auto
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# (tuỳ chọn) ghi đè model:
# DEEPSEEK_MODEL=deepseek-chat
# GEMINI_MODEL=
# OPENAI_MODEL=gpt-4o-mini


# ── 3) PHÒNG / HÀNH VI ──────────────────────────────────────────────────────
AGENT_ROOM=lobby
# MANIFEST_ROOM=lobby
PROACTIVE=on


# ── 4) FLOP LEDGER — mặc định CHẠY KHÔ (simulation) ─────────────────────────
# Để trống/0 = simulation (chỉ trừ số dư MOCK, KHÔNG lên chain). An toàn để test.
# Chỉ bật "1" khi FLOP mở endpoint inference thật VÀ bạn đã điền RPC/SUBMIT dưới.
TESTNET_ENABLED=0
# FLOP_RPC_URL=
# FLOP_SUBMIT_URL=
# Adapter gửi tx settle: relay (mặc định, POST đã-ký tới FLOP_SUBMIT_URL) | evm (stub) | off.
# FLOP_TX_MODE=relay
FLOP_TOKEN_SYMBOL=FLOP
FLOP_UNLOCK_RATIO=3
# TOKEN_LEDGER_FILE=token_ledger.json
# FLOP_INFERENCE_COST=


# ── 4b) SESSION INFERENCE (spend-to-earn) — mặc định TẮT ────────────────────
# Mỗi vòng cron ĐĂNG 1 yêu cầu phiên inference -> PoUI -> settle -> tích mở khóa 3:1.
# Bật "1" để nối vào agent. SIMULATION (TESTNET_ENABLED=0) chạy thợ đào GIẢ để kiểm
# wiring (KHÔNG tích mở khóa); TESTNET cần FLOP_MEMPOOL_URL + submit_fn THẬT — tới khi
# FLOP công bố endpoint thì trả skipped_unconfigured (KHÔNG bịa thợ đào). Lưu ý: tỉ lệ
# 3:1 và "đây là đường earn chính" đều từ bản NHÁP, CHƯA được Yellow Paper chốt.
# FLOP_SESSION_ENABLED=
# Hash trọng số mô hình muốn chạy — BẮT BUỘC khi bật (thiếu -> agent bỏ qua, không bịa hash).
# FLOP_SESSION_MODEL_HASH=
# Endpoint mempool để đăng yêu cầu phiên (nạp khi FLOP công bố; rỗng -> skipped_unconfigured).
# FLOP_MEMPOOL_URL=
# Tham số phiên (dùng mặc định nếu để trống):
# FLOP_SESSION_FLOPS=1000000000
# FLOP_SESSION_MAX_LATENCY_MS=2000
# Số phiên mua/run (earn = tuyến tính pro-rata theo settled spend). Mặc định 1; tăng khi
# testnet mở để tối đa spend HỢP PHÁP (đừng vượt mức "manufactured activity").
# FLOP_SESSION_MAX_PER_RUN=1


# ── 5) KNOB CHỐNG SYBIL — BẬT NGAY từ đầu cho fork mới ──────────────────────
# Chỉ chi FLOP khi có sự kiện thật (event_id từ @mention) → chặn burn-loop tổng hợp.
FLOP_ORGANIC_ONLY=1
# Trần số lần chi mỗi giờ (đếm từ ledger) — phá pattern đều như máy.
FLOP_MAX_SPENDS_PER_HOUR=6
# Jitter ±% lượng chi mỗi lần — phá đường tuyến tính. (0..~30 hợp lý)
FLOP_PACE_JITTER_PCT=12
# Ngân sách/giới hạn nhịp chi:
# FLOP_DAILY_BUDGET=
# FLOP_MAX_PER_RUN=
# FLOP_MIN_SPEND=
# FLOP_PACER_FILE=flop_pacer.json


# ── 6) FAUCET — có chừng mực, KHÔNG claim 24/7 ──────────────────────────────
# Bật claim test token (nối sẵn vào cron, adapter HTTP mặc định). Mặc định TẮT ->
# skipped_disabled. Cần FLOP_FAUCET_URL thật khi FLOP mở.
# FLOP_FAUCET_ENABLED=
# FLOP_FAUCET_URL=
# FLOP_FAUCET_AMOUNT=
# Chỉ claim khi số dư CẠN (cần ngưỡng refill) — dấu hiệu "người dùng thật".
FLOP_FAUCET_DEMAND_ONLY=1
# FLOP_FAUCET_REFILL_BELOW=
# Trần claim/ngày + jitter cooldown (phút) — tránh chữ ký bot.
FLOP_FAUCET_MAX_PER_DAY=2
FLOP_FAUCET_JITTER_MIN=1
# FLOP_FAUCET_COOLDOWN_HOURS=
# FLOP_FAUCET_STATE=flop_faucet.json


# ── 7) MINH BẠCH (nên bật) ──────────────────────────────────────────────────
# Công khai spend_stats() để tự audit — có ích nếu FLOP kiểm tra hồi tố.
FLOP_PUBLISH_UNLOCK=1


# ── 8) (tuỳ chọn) KIBBLE WORKER — mặc định dry-run, để tắt nếu chưa cần ──────
# FLOP_KIBBLE_ENABLED=
# FLOP_KIBBLE_DRY_RUN=on
# FLOP_KIBBLE_ROOM=kibble
# FLOP_KIBBLE_CLAIM=on
# FLOP_KIBBLE_TYPES=explain,coordinate,summarize
